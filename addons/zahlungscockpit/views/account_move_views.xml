<odoo>
    <record id="view_move_form_verzug" model="ir.ui.view">
        <field name="name">account.move.form.verzug</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="zahlungsverzug_tage"/>
                <field name="skonto_status" widget="badge"
                       decoration-success="skonto_status == 'genutzt'"
                       decoration-danger="skonto_status == 'verpasst'"
                       decoration-info="skonto_status == 'offen'"/>
                <field name="skonto_moeglich"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_verzug" model="ir.ui.view">
        <field name="name">account.move.tree.verzug</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="zahlungsverzug_tage" optional="show"
                       decoration-danger="zahlungsverzug_tage &gt; 0"
                       decoration-success="zahlungsverzug_tage &lt;= 0
                                            and ist_bezahlt"/>
                <field name="ist_bezahlt" column_invisible="1"/>
                <field name="skonto_status" optional="show"/>
                <field name="skonto_moeglich" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>