<odoo>
    <record id="res_config_settings_view_form_qm" model="ir.ui.view">
        <field name="name">res.config.settings.form.qm</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="QM Freigabe" name="qm_freigabe">
                    <block title="Chargensperre">
                        <setting string="Sperrmodus"
                                 help="Verhalten, wenn eine nicht freigegebene Charge ausgeliefert wird">
                            <field name="qm_sperrmodus"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>