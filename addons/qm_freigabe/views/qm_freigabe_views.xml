<odoo>
    <!-- FORM -->
    <record id="view_qm_freigabe_form" model="ir.ui.view">
        <field name="name">qm.freigabe.form</field>
        <field name="model">qm.freigabe</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pruefung_starten" type="object"
                            string="Prüfung starten" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_freigeben" type="object"
                            string="Freigeben" class="btn-primary"
                            invisible="state != 'pruefung'"/>
                    <button name="action_sperren" type="object"
                            string="Sperren" class="btn-danger"
                            invisible="state in ('gesperrt', 'draft')"/>
                    <button name="action_zuruecksetzen" type="object"
                            string="Zurücksetzen"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pruefung,freigegeben"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pruefdatum"/>
                        </group>
                        <group>
                        </group>
                    </group>
                    <group string="Bemerkung">
                        <field name="bemerkung" nolabel="1"/>
                    </group>
                    <group string="Verknüpfte Chargen">
                        <field name="lot_ids" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="product_id"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_qm_freigabe_search" model="ir.ui.view">
        <field name="name">qm.freigabe.search</field>
        <field name="model">qm.freigabe</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_pruefung" string="In Prüfung"
                        domain="[('state', '=', 'pruefung')]"/>
                <filter name="filter_freigegeben" string="Freigegeben"
                        domain="[('state', '=', 'freigegeben')]"/>
                <filter name="filter_gesperrt" string="Gesperrt"
                        domain="[('state', '=', 'gesperrt')]"/>
                <separator/>
                <group expand="0" string="Gruppieren nach">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_qm_freigabe_list" model="ir.ui.view">
        <field name="name">qm.freigabe.list</field>
        <field name="model">qm.freigabe</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'freigegeben'"
                  decoration-danger="state == 'gesperrt'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="pruefdatum"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_qm_freigabe" model="ir.actions.act_window">
        <field name="name">Chargenfreigaben</field>
        <field name="res_model">qm.freigabe</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>